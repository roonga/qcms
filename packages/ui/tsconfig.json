{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // The test corpus loader needs Node globals under Bundler resolution.
    "types": ["node"],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    // Match the upstream optional-property and indexed-access semantics to preserve the vendored sources unchanged.
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false
  },
  // Typecheck generators without shipping their Node-only imports through the public UI surface.
  "include": ["src", "tools"]
}
