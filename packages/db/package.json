{
  "name": "@roonga/qcms-db",
  "version": "0.0.0",
  "private": false,
  "description": "qcms Drizzle schema, migrations, and the Testcontainers test harness (task 013)",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/harness.d.ts",
      "default": "./dist/testing/harness.js"
    },
    "./migrate": {
      "types": "./dist/migrate.d.ts",
      "default": "./dist/migrate.js"
    },
    "./environment": {
      "types": "./dist/environment/index.d.ts",
      "default": "./dist/environment/index.js"
    }
  },
  "bin": {
    "qcms-db-migrate": "./dist/migrate.js",
    "qcms-db-environment": "./dist/environment-cli.js"
  },
  "files": [
    "dist",
    "src",
    "migrations",
    "!src/**/*.test.*",
    "!src/**/__snapshots__/**",
    "!src/test-support/**"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. --project @roonga/qcms-db",
    "lint": "node ../../scripts/eslint-workspace.mjs src scripts",
    "migrate": "node dist/migrate.js",
    "db:generate": "drizzle-kit generate",
    "db:emit-baseline": "tsx scripts/emit-baseline.mts"
  },
  "dependencies": {
    "@roonga/qcms-a2ui-compiler": "workspace:*",
    "@roonga/qcms-core": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.0"
  },
  "peerDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "testcontainers": "^12.1.0"
  },
  "peerDependenciesMeta": {
    "@testcontainers/postgresql": {
      "optional": true
    },
    "testcontainers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "testcontainers": "^12.1.0"
  }
}
