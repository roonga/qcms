{
  "name": "@qcms/db",
  "version": "0.0.0",
  "private": false,
  "description": "qcms Drizzle schema, migrations, and the Testcontainers test harness (task 013)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./src/testing/harness.ts",
      "default": "./src/testing/harness.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "migrations",
    "!src/**/*.test.*",
    "!src/**/__snapshots__/**",
    "!src/test-support/**"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. --project @qcms/db",
    "lint": "eslint src",
    "migrate": "node dist/migrate.js",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@qcms/a2ui-compiler": "workspace:*",
    "@qcms/core": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0"
  },
  "peerDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "testcontainers": "^12.1.0"
  },
  "peerDependenciesMeta": {
    "@testcontainers/postgresql": {
      "optional": true
    },
    "testcontainers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/pg": "^8.21.0",
    "drizzle-kit": "^0.31.10",
    "testcontainers": "^12.1.0"
  }
}
