{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Keep the published layout at dist/*; inheriting the authoring root would emit dist/src/*.
    "rootDir": "src"
  },
  "include": ["src"],
  // Build the public testing subpath and its Docker-auth side-effect import; exclude only tests.
  "exclude": ["**/*.test.ts"]
}
