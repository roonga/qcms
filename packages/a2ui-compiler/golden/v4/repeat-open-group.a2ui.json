{
  "documents": [
    {
      "stepId": "stp_fleet",
      "root": {
        "type": "Form",
        "children": [
          {
            "type": "Flex",
            "props": {
              "direction": "column",
              "gap": "md"
            },
            "children": [
              {
                "type": "Text",
                "props": {
                  "as": "h1",
                  "size": "2xl",
                  "weight": "bold"
                },
                "children": "Fleet vehicles"
              },
              {
                "type": "Text",
                "props": {
                  "as": "h2",
                  "size": "xl",
                  "weight": "semibold"
                },
                "children": "The vehicles on this policy"
              },
              {
                "type": "TextField",
                "props": {
                  "label": "Fleet name",
                  "name": "q_rep_fleet_name",
                  "isRequired": true,
                  "maxLength": 60
                }
              },
              {
                "type": "RepeatGroup",
                "props": {
                  "groupId": "grp_vehicles",
                  "label": "Vehicles",
                  "instanceLabel": "Vehicle {n}",
                  "presentation": "stacked",
                  "countSource": "open",
                  "min": 1,
                  "max": 9,
                  "addLabel": "Add Vehicle",
                  "removeLabel": "Remove {label}"
                },
                "children": [
                  {
                    "type": "TextField",
                    "props": {
                      "label": "Registration plate",
                      "description": "As printed on the plate, without spaces",
                      "name": "q_rep_plate",
                      "isRequired": true,
                      "minLength": 3,
                      "maxLength": 8
                    }
                  },
                  {
                    "type": "DatePicker",
                    "props": {
                      "label": "Last service date",
                      "name": "q_rep_service_date",
                      "granularity": "day",
                      "minValue": "2000-01-01",
                      "maxValue": "2100-12-31"
                    }
                  },
                  {
                    "type": "NumberField",
                    "props": {
                      "label": "Odometer reading",
                      "name": "q_rep_odometer",
                      "isRequired": true,
                      "minValue": 0,
                      "maxValue": 999999,
                      "step": 1
                    }
                  }
                ]
              },
              {
                "type": "Honeypot",
                "props": {
                  "name": "website",
                  "autoComplete": "off",
                  "ariaHidden": true,
                  "tabIndex": -1
                }
              }
            ]
          }
        ]
      }
    }
  ],
  "compilerVersion": "0.3.0",
  "a2uiSpecVersion": "1.0.0-preview.7"
}
