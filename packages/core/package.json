{
  "name": "@qcms/core",
  "version": "0.0.0",
  "private": false,
  "description": "qcms domain kernel: schemas, rules DSL + evaluator, publish invariants (placeholder, task 001)",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "!src/**/__snapshots__/**",
    "!src/test-support/**"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. --project @qcms/core",
    "coverage": "vitest run --root ../.. --project @qcms/core --coverage",
    "lint": "eslint src"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "fast-check": "^4.9.0"
  }
}
