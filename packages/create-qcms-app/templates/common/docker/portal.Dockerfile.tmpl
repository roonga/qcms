# syntax=docker/dockerfile:1
# check=skip=SecretsUsedInArgOrEnv
# The action key is recoverable from the server manifest; published images must receive no shared key.
FROM node:24-bookworm-slim@sha256:c86ecead9e55a5210ac1727de38a4ca840bf03dcaf34dc9749addbf383b1920c AS build

WORKDIR /workspace
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc tsconfig.base.json ./
COPY apps ./apps

RUN pnpm install --frozen-lockfile

# A stable action key preserves held no-JS forms across deploys.
# Next embeds the key in the server manifest: treat images as secrets and never share it in public images.
# See docs/deploy-ingress.md for the operator procedure.
ARG NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""
RUN NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="${NEXT_SERVER_ACTIONS_ENCRYPTION_KEY}" \
    pnpm --filter qcms-portal build

FROM node:24-bookworm-slim@sha256:c86ecead9e55a5210ac1727de38a4ca840bf03dcaf34dc9749addbf383b1920c AS runtime

ARG VERSION=dev
LABEL org.opencontainers.image.title="{{projectName}}-portal" \
      org.opencontainers.image.version="${VERSION}"
# No org.opencontainers.image.source: this image is built from YOUR tree, which
# you have owned since create-qcms-app stamped it, so no scaffolder can know where
# it lives. Add the label yourself once it has a home:
#   org.opencontainers.image.source="https://example.com/your/repository"

WORKDIR /app
ENV NODE_ENV=production
# The standalone server reads its bind configuration from the environment, not command-line flags.
ENV HOSTNAME=0.0.0.0 \
    PORT=3000
# The workspace tracing root preserves monorepo paths while copying only the server dependency closure.
COPY --from=build --chown=node:node /workspace/apps/portal/.next/standalone ./
# Standalone tracing omits static assets for CDN deployments; this server must carry them itself.
COPY --from=build --chown=node:node /workspace/apps/portal/.next/static ./apps/portal/.next/static
USER node
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=6 CMD node -e "fetch('http://127.0.0.1:3000/').then((r) => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"
CMD ["node", "apps/portal/server.js"]
