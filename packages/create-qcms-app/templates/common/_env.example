# QCMS stack environment reference, generated from parsed configuration and operator metadata.
# create-qcms-app wrote sibling `.env` with your answers and fresh random secrets.
# Edit `.env` for runtime configuration; keep it git-ignored and never commit secrets.
#
# Requirement legend:
#   required     the stack refuses to start without it
#   conditional  required when its feature is enabled
#   optional     safe to leave unset; the documented default applies

# Portal-image build secret passed to docker/portal.Dockerfile: 32 bytes
# base64. Pinning preserves action ids across deploys, avoiding 409 and loss
# of unsaved values on held scriptless Add/Remove requests. Keys are readable
# in image manifests; pinning shares that exposure across builds. Published
# ghcr.io/roonga/qcms-portal images have no shared key. See
# docs/deploy-ingress.md.
# (optional, secret, default unset - Next generates a fresh key for every build)
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# OTLP collector endpoint. Unset disables the SDK; set exports traces and
# allowlisted logs.
# (optional)
# OTEL_EXPORTER_OTLP_ENDPOINT=

# Contact address for the Let's Encrypt account. Required by the proxy
# overlay; unused without it.
# (conditional)
# QCMS_ACME_EMAIL=

# Must match the API's value; it decides whether enrollment can be skipped.
# (optional, default required)
# QCMS_ADMIN_2FA=

# better-auth signing and encryption secret, at least 32 characters; required
# when admin is mounted. Back up with the database: replacing it makes stored
# TOTP secrets and recovery codes unreadable. Rotate through
# QCMS_ADMIN_AUTH_SECRETS; see Admin auth secret rotation in
# docs/operations.md.
# (conditional, secret)
QCMS_ADMIN_AUTH_SECRET=

# Comma-separated <version>:<secret> keys, strictly descending, newest first,
# for example 2:<new>,1:<old>. Each needs at least 32 characters. The first
# encrypts new material; retain older keys to read existing factors. Leave
# unset unless rotating. See Admin auth secret rotation in docs/operations.md.
# (optional, secret, default unset - version 1 holds QCMS_ADMIN_AUTH_SECRET)
# QCMS_ADMIN_AUTH_SECRETS=

# Browser-facing admin origin for state-changing origin checks. Match the API
# configuration exactly.
# (required)
QCMS_ADMIN_BASE_URL=

# Public hostname Caddy serves the admin app on. Required by the proxy
# overlay; unused without it.
# (conditional)
# QCMS_ADMIN_DOMAIN=

# Checks passwords through api.pwnedpasswords.com/range/{prefix}, sending only
# five SHA-1 hex characters. Unreachable service refuses passwords, including
# first-admin creation. Disable only for offline operation or emergency
# rotation during an outage; API and CLI startup warn of the security
# downgrade.
# (optional, default true)
# QCMS_ADMIN_PASSWORD_BREACH_CHECK=

# Host port the admin app is published on. Same allocation rules as the
# portal.
# (optional, default 7040)
# QCMS_ADMIN_PORT=

# Match the API Secure-cookie policy or different cookie families can cause
# sign-in loops. False is allowed only on loopback such as
# http://localhost:7040; other origins refuse boot.
# (optional, default true when NODE_ENV=production)
# QCMS_ADMIN_SECURE_COOKIES=

# Actual trusted hops counted from the right of X-Forwarded-For for sign-in
# throttling; 1 fits the ingress recipes. Too many trusts client text and
# bypasses throttling; too few merges proxy buckets. 0 shares one bucket.
# Invalid counts refuse boot. Match the portal count unless ingress differs;
# see docs/deploy-ingress.md.
# (optional, default 1)
# QCMS_ADMIN_TRUSTED_PROXY_HOPS=

# Required for real model providers except local endpoints: loopback, private
# IP ranges, host.docker.internal, or .local, .localhost and .internal hosts.
# Never logged or echoed in boot errors.
# (conditional, secret)
# QCMS_AGENT_API_KEY=

# Model endpoint override; required for openai-compatible, including Ollama,
# vLLM, LM Studio and llama.cpp-server. Hosted providers may use it for a
# gateway or proxy.
# (conditional)
# QCMS_AGENT_BASE_URL=

# Maximum tool-loop steps per agent turn.
# (optional, default 8)
# QCMS_AGENT_MAX_STEPS=

# The model provider's own model id, never interpreted here. Required when
# QCMS_FLAG_AGENT_AUTHORING names a real provider, ignored otherwise.
# (conditional)
# QCMS_AGENT_MODEL=

# off drops reasoning, including unsolicited parts; summary requests the
# provider summary for a collapsed Thinking disclosure. Text is never logged,
# stored, exported or replayed; only token counts are logged. Reasoning is
# billed output within the turn-step cap. API-only configuration; admin
# receives events, never this value.
# (optional, default off)
# QCMS_AGENT_THINKING=

# AES-256-GCM key, at least 32 characters, for stored webhook HMAC secrets.
# Set once and back up: no in-place rotation exists, and replacement makes
# deliveries dead-letter. Recover by reissuing each webhook secret,
# coordinating consumers and redelivering. Two-factor keys use
# QCMS_ADMIN_AUTH_SECRET. See the App encryption key runbook in
# docs/operations.md.
# (required, secret)
QCMS_APP_KEY=

# Interface the two published apps bind to. The loopback default is a control:
# a bare publish would listen on every interface, ahead of the host firewall.
# Widen it only when a separate ingress host must reach these containers.
# (optional, default 127.0.0.1)
# QCMS_BIND_ADDRESS=

# Ingress image, used only by the docker-compose.proxy.yml overlay.
# (optional, default caddy:2-alpine)
# QCMS_CADDY_IMAGE=

# Control-pool password for qcms_app_control: control DML excluding
# break-glass audit, and INSERT-only environment outboxes. Use distinct
# application-role passwords. See Least-privilege database roles in
# docs/operations.md.
# (required, secret)
QCMS_DB_APP_CONTROL_PASSWORD=

# Prod-pool password for qcms_app_prod: DML only on data_prod and named
# control reads. Use distinct application-role passwords. See Least-privilege
# database roles in docs/operations.md.
# (required, secret)
QCMS_DB_APP_PROD_PASSWORD=

# Test-pool password for qcms_app_test: DML only on data_test and named
# control reads. Use distinct application-role passwords. See Least-privilege
# database roles in docs/operations.md.
# (required, secret)
QCMS_DB_APP_TEST_PASSWORD=

# Schema-owner password for the one-shot qcms_migrate role, held only by the
# migration service. See Least-privilege database roles in docs/operations.md.
# (required, secret)
QCMS_DB_MIGRATE_PASSWORD=

# Database name created on first boot of the Postgres volume.
# (optional, default qcms)
# QCMS_DB_NAME=

# Bootstrap superuser password, required by Compose. Only db-roles uses it to
# create migration, control and environment roles; traffic-serving processes
# must not hold it.
# (required, secret)
QCMS_DB_PASSWORD=

# Bootstrap superuser created with the Postgres volume; used only to create
# least-privilege roles.
# (optional, default qcms)
# QCMS_DB_USER=

# Comma-separated live environments, including prod. Each needs
# QCMS_DATABASE_URL_<ENV>; the API refuses boot unless the set exactly matches
# control.environments. Requests without an environment use prod. Admin
# x-qcms-environment selections must belong to this set or return 400.
# (optional, default test,prod)
# QCMS_ENVIRONMENTS=

# Match the API provider setting to mount the panel and streaming proxy.
# Browser code receives enabled behavior; provider keys stay in the API.
# (optional, default none)
# QCMS_FLAG_AGENT_AUTHORING=

# Version stamped into the images at build time
# (org.opencontainers.image.version). pnpm qcms:build-images derives a real
# one; a bare docker compose build leaves it dev.
# (optional, default dev)
# QCMS_IMAGE_VERSION=

# BFF service tokens, at least 32 characters each. Any listed token is
# accepted; retain both during a two-deploy rotation.
# (required, secret)
QCMS_INTERNAL_TOKEN=

# Secure-link signing keys, at least 32 characters each. Comma-separated: the
# first signs, all verify. Rotation runbook: docs/secure-links.md.
# (required, secret)
QCMS_LINK_KEYS=

# BCP 47 formatting tag, for example en-GB, en-US or de-DE; copy stays
# English. Match portal for preview dates, field order, numbers and lists.
# Blank defaults to en-GB; invalid tags or unavailable Intl data refuse boot
# without echoing the value. Operator timestamps use the browser zone.
# (optional, default en-GB)
# QCMS_LOCALE=

# Public origin of the respondent portal, used to build the secure-link URLs
# authors copy. Absolute http(s); a trailing slash is stripped.
# (required)
QCMS_PORTAL_BASE_URL=

# URL of the brand logo shown in the portal header.
# (optional)
# QCMS_PORTAL_BRAND_LOGO=

# Brand name shown in the portal header. Empty renders no brand.
# (optional)
# QCMS_PORTAL_BRAND_NAME=

# Corner-radius token group.
# (optional, default subtle)
# QCMS_PORTAL_CORNERS=

# Spacing token group.
# (optional, default the @roonga/qcms-ui default density)
# QCMS_PORTAL_DENSITY=

# Public hostname Caddy serves the portal on. Required by the proxy overlay;
# unused without it.
# (conditional)
# QCMS_PORTAL_DOMAIN=

# Comma-separated non-prod environments served under /<env>/, for example
# https://forms.example.com/test/l/<token>. Prod is always unprefixed; listing
# it is ignored. Absent lists none, so other environment paths return 404.
# Names must match ^[a-z][a-z0-9]*$; invalid names are ignored. Match the API
# QCMS_MOUNT.
# (optional)
# QCMS_PORTAL_ENVIRONMENTS=

# <env>=<host> pairs, for example test=test-forms.example.com. Listed hosts
# disable anonymous /f/{slug} access; they do not confine /<env>/ paths to
# that hostname. Host and path restrictions work independently. Enforce
# network, VPN or identity access at ingress; see Restricting the test
# environment in docs/deploy-ingress.md.
# (optional)
# QCMS_PORTAL_ENVIRONMENT_HOSTS=

# Default font registry key. Unknown or excluded keys use the system stack.
# (optional, default the system font stack)
# QCMS_PORTAL_FONT=

# Offered font registry keys from apps/portal/lib/server/theme.ts, separated
# by commas or spaces. Blank offers all; unknown keys are ignored and system
# is always offered.
# (optional)
# QCMS_PORTAL_FONTS=

# Default mode: light, dark, auto or hc (high contrast).
# (optional, default auto)
# QCMS_PORTAL_MODE=

# Published portal host port from docs/PORTS.md; choose another allocated slot
# when running beside a dev server.
# (optional, default 7000)
# QCMS_PORTAL_PORT=

# Match the portal theme so previews show respondent appearance. Unknown
# values use the same fallback as portal; admin chrome keeps its own theme.
# (optional, default slate)
# QCMS_PORTAL_THEME=

# Actual trusted hops counted from the right of X-Forwarded-For; 1 fits both
# ingress recipes in docs/deploy-ingress.md. Too many trusts client text and
# bypasses limits; too few merges buckets at a proxy. 0 trusts no forwarded
# address and shares one bucket. Invalid counts refuse boot.
# (optional, default 1)
# QCMS_PORTAL_TRUSTED_PROXY_HOPS=

# Postgres image; override to use an image mirror instead of Docker Hub.
# (optional, default postgres:16-alpine)
# QCMS_POSTGRES_IMAGE=

# Agent turns one administrator may request per window.
# (optional, default 10)
# QCMS_RL_AGENT_ASSIST_MAX=

# Rate-limit window for POST /admin/forms/{id}/draft/assist, keyed by admin
# principal.
# (optional, default 60000)
# QCMS_RL_AGENT_ASSIST_WINDOW_MS=

# Secure respondent cookies; leave unset behind TLS. False is allowed only on
# loopback such as http://localhost:7000; other origins refuse boot. Accepts
# trimmed, case-insensitive true/1/yes/on or false/0/no/off; invalid values
# refuse boot. Unset or blank uses NODE_ENV.
# (optional, default true when NODE_ENV=production)
# QCMS_SECURE_COOKIES=

# Respondent session-token signing keys, at least 32 characters each. Same
# first-signs-all-verify rotation model as QCMS_LINK_KEYS.
# (required, secret)
QCMS_SESSION_KEYS=

# Development opt-in that admits QCMS_SMTP_SECURITY=none for a local relay
# such as Mailpit. Never set it in a deployment: links would cross the network
# unencrypted. Credentials are refused over plaintext even with it set.
# (optional, default false)
# QCMS_SMTP_ALLOW_INSECURE=

# Sender, required when QCMS_SMTP_HOST is set: an address or Name <address> on
# one line.
# (conditional)
# QCMS_SMTP_FROM=

# Outbound mail relay. Unset leaves mail unconfigured, which features that
# email a sign-in link read before acting. Mail is configured only where admin
# is mounted, since every link points at QCMS_ADMIN_BASE_URL. See Outbound
# email in docs/DEVELOPER_GUIDE.md.
# (optional)
# QCMS_SMTP_HOST=

# Relay password; set together with QCMS_SMTP_USER. Never logged or echoed in
# boot errors; example-file placeholders refuse boot.
# (conditional, secret)
# QCMS_SMTP_PASSWORD=

# Relay port.
# (optional, default 587, 465 for tls, 25 for none)
# QCMS_SMTP_PORT=

# starttls requires the STARTTLS upgrade and refuses a relay that does not
# offer it; tls is implicit TLS. Certificates are always verified. none is
# plaintext and refused at boot unless QCMS_SMTP_ALLOW_INSECURE=true.
# (optional, default starttls)
# QCMS_SMTP_SECURITY=

# Per-phase limit for the relay: connecting, waiting for the greeting, and
# socket inactivity. It does not cap total send time; a phase that exceeds it
# fails the send as undeliverable.
# (optional, default 10000)
# QCMS_SMTP_TIMEOUT_MS=

# Relay user name; set together with QCMS_SMTP_PASSWORD, or neither.
# (conditional)
# QCMS_SMTP_USER=
