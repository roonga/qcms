# Route only the two frontends. Adding an API upstream would expose the private domain-data boundary.
{
	email {$QCMS_ACME_EMAIL}
}

# Apps assume TLS; only the browser-facing ingress can enforce edge transport policy.
(qcms_edge) {
	encode zstd gzip

	header {
		# Remove preload if any sibling hostname still serves plain HTTP.
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		-Server
	}

	# Keep the edge body ceiling aligned with QCMS_BODY_LIMIT_BYTES so oversized requests stop before Node.
	request_body {
		max_size 1MB
	}
}

{$QCMS_PORTAL_DOMAIN} {
	import qcms_edge
	# Replace forwarded addresses with the verified peer; appending would let callers choose limiter buckets.
	# If another proxy precedes Caddy, configure its trust and the application hop counts together.
	reverse_proxy portal:3000 {
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-For {remote_host}
	}
}

{$QCMS_ADMIN_DOMAIN} {
	import qcms_edge
	# Keep forwarding and trusted-hop counts aligned or sign-in backoff becomes forgeable.
	reverse_proxy admin:3000 {
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-For {remote_host}
	}
}
