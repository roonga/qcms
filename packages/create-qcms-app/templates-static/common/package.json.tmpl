{
  "name": "{{projectName}}",
  "version": "0.1.0",
  "private": true,
  "description": "A QCMS deployment: owned application shell over the versioned @roonga/qcms-* packages.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
{{packageManagerField}}  "scripts": {
    "up": "docker compose up -d --build",
    "down": "docker compose down",
    "logs": "docker compose logs -f",
    "migrate": "docker compose run --rm migrate",
    "build": "{{recursiveBuild}}",
    "typecheck": "{{recursiveTypecheck}}",
    "prompts:generate": "node scripts/generate-prompts.mjs --write",
    "check:prompts": "node scripts/generate-prompts.mjs --check",
    "verify": "pnpm check:prompts && pnpm build && pnpm typecheck"
  },
  "devDependencies": {
    "prettier": "^3.10.1"
  }
}
