{
  "name": "@qcms/csv",
  "version": "0.0.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "!src/**/__snapshots__/**"
  ],
  "description": "Shared CSV field serialization for QCMS exports: RFC 4180 quoting and the spreadsheet formula-injection guard",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. --project @qcms/csv",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/node": "^24.13.3"
  }
}
