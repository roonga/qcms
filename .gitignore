node_modules/
# pnpm places its store beside node_modules when the default store is on another filesystem.
.pnpm-store/
dist/
dist-images/
dist-attestations/
dist-image-scan/
.turbo/
coverage/
# Reports are generated even by ad hoc reporters; untracked report trees must not enter source gates.
.vitest/
.claude/worktrees/
# Per-machine permission grants must never be shared with the tracked harness configuration.
**/.claude/settings.local.json
.env
.env.*
!.env.example
!.env.compose.example
*.log
.DS_Store
# The browser harness writes live local administrator credentials here; never commit them.
.e2e-full-stack-credentials.json
test-results/
playwright-report/
blob-report/

# Next generates these app-local instructions at build time; they are not repository policy.
apps/*/AGENTS.md
apps/*/CLAUDE.md

# The guidance opt-out does not delete files generated in older checkouts.
/AGENTS.md

# WSL can create a single profile directory whose name contains backslashes; escape them for gitignore.
C:\\Users\\*

# The lint fixture must live under the root config; cover runs that die before cleanup.
/.lint-cwd-fixture-*/
