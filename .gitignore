node_modules/
# pnpm relocates its content-addressable store next to node_modules when the
# default store dir is on a different filesystem - which is exactly the case in
# the dev container (bind-mounted workspace vs container home, task 046).
.pnpm-store/
dist/
.turbo/
coverage/
.claude/worktrees/
.env
.env.*
!.env.example
!.env.compose.example
*.log
.DS_Store
# Generated by the isolated full-stack browser-test workflow. This file holds the
# random local-only administrator credential printed by `pnpm docker:up`. It must
# stay ignored under whatever name the harness writes: it was committed once,
# with live values, the moment a rename outran this line.
.e2e-full-stack-credentials.json
test-results/
playwright-report/
blob-report/

# Written (and re-written) by `next dev` itself: `generate-agent-files.js` drops an
# `AGENTS.md` plus a `CLAUDE.md` that includes it into each Next app the moment a dev
# server starts, which is every Playwright run. They are generator output, not
# authored content, and their text carries em dashes that `check:no-em-dash`
# correctly refuses - so a `git add -A` after a browser run used to red the gate with
# a file nobody wrote. Ignored rather than fought: deleting them only re-creates them.
apps/*/AGENTS.md
apps/*/CLAUDE.md
