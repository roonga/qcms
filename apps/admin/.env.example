# QCMS admin - server-only configuration (task 031).
# The admin is a strict BFF plus its own better-auth instance: every value here
# stays on the server and never reaches the client bundle. Copy to .env.local for
# local development.

# Postgres. better-auth keeps the admin's users, sessions, accounts and TOTP
# secrets here, in the auth tables @qcms/db owns.
#
# The value below is the LOCAL dev database this seat runs (7S20, so 7020 at the
# default seat - docs/PORTS.md), which is what `pnpm dev:portal` brings up. It is a
# development convenience, not a production default: a real deployment points this
# at its own Postgres, and nothing about 7020 belongs there.
DATABASE_URL=postgres://qcms:qcms@127.0.0.1:7020/qcms

# This app's own public origin. better-auth scopes cookies to it and builds the
# authenticator account URI from it. No trailing slash needed.
#
# 7S40 is the admin's allocated dev port (docs/PORTS.md). Next's own default is
# 3000, so start the admin with `--port 7040` to match this value.
QCMS_ADMIN_BASE_URL=http://localhost:7040

# The better-auth signing secret (>= 32 chars, random). Rotating it invalidates
# every admin session and every pending 2FA challenge.
QCMS_ADMIN_AUTH_SECRET=replace-with-a-32-char-plus-random-secret

# The internal API base URL (server-only). The API container is never published
# (ADR-20); only the admin's BFF reaches it. No trailing slash needed.
QCMS_API_BASE_URL=http://127.0.0.1:7010

# The SEC-4 internal service token presented on every API call (>= 32 chars).
# Must match one of the API's QCMS_INTERNAL_TOKEN values.
QCMS_INTERNAL_TOKEN=replace-with-a-32-char-plus-internal-token

# Admin TOTP 2FA policy (SEC-1). Default (unset) = required, which is the only
# supported production value. `optional` is the documented DEVELOPMENT escape
# hatch: it lets an admin skip enrollment entirely. The API reads the same var,
# so relax it in both places or not at all.
# QCMS_ADMIN_2FA=optional

# Admin session lifetimes in ms (SEC-1 defaults: 1h idle, 12h absolute). The
# absolute cap is measured from when the session was issued, so activity cannot
# extend it. Keep QCMS_ADMIN_SESSION_MAX_AGE_MS in step with the API's value.
# QCMS_ADMIN_SESSION_IDLE_MS=3600000
# QCMS_ADMIN_SESSION_MAX_AGE_MS=43200000

# First-run bootstrap (`pnpm qcms:create-admin`). Set these only for that one
# command; it refuses to run once any admin account exists.
# QCMS_ADMIN_EMAIL=you@example.test
# QCMS_ADMIN_PASSWORD=a long passphrase
# QCMS_ADMIN_NAME=Administrator
