# Server-only BFF configuration. Copy to .env.local for local development; never commit secrets.
# Database credentials and better-auth secrets belong only to the API. Auth travels over the internal channel.

# Browser-facing origin, without a trailing slash; must match the API's auth and trusted-origin configuration.
# Start Next with --port 7040 to match the allocated admin dev slot; see docs/PORTS.md.
QCMS_ADMIN_BASE_URL=http://localhost:7040

# Internal API origin. Keep the API container unpublished; only the BFF reaches this address.
QCMS_API_BASE_URL=http://127.0.0.1:7010

# At least 32 characters; must match one of the API's QCMS_INTERNAL_TOKEN values.
QCMS_INTERNAL_TOKEN=replace-with-a-32-char-plus-internal-token

# Unset means NODE_ENV=production uses Secure cookies. The API must use the same value for auth cookies.
# False is allowed only on loopback; non-loopback downgrades refuse boot. Use TLS or a loopback tunnel.
# QCMS_ADMIN_SECURE_COOKIES=false

# Required 2FA is the production policy. Optional skips enrollment for development only.
# The API reads the same setting; configure both together.
# QCMS_ADMIN_2FA=optional

# Absolute lifetime in milliseconds, default 12h from issue time; activity cannot extend it.
# Keep API and admin aligned: the shorter cap wins. The API alone configures the idle window (default 1h).
# QCMS_ADMIN_SESSION_MAX_AGE_MS=43200000

# Match the portal's respondent theme for previews: slate (default) | harbor | sand | plum.
# Blank or unknown values fall back to slate. Admin chrome keeps its own appearance.
# QCMS_PORTAL_THEME=slate

# BCP 47 formatting locale, default en-GB; copy stays English. Match the portal for preview fidelity.
# Invalid tags or unavailable Intl data refuse boot. Operator timestamps use the browser's zone, not this setting.
# QCMS_LOCALE=en-GB

# Bootstrap with pnpm qcms:create-admin on the API. QCMS_ADMIN_EMAIL, QCMS_ADMIN_PASSWORD and
# QCMS_ADMIN_NAME belong in its environment; see apps/admin/README.md.

# Match the API's authoring flag to mount the panel and streaming proxy. Unset or none disables both.
# The provider model and API key remain API-only configuration.
# QCMS_FLAG_AGENT_AUTHORING=none
