# QCMS admin - server-only configuration.
# The admin is a strict BFF and nothing else: every value here stays on the server
# and never reaches the client bundle. Copy to .env.local for local development.
#
# There is deliberately NO connection string and NO auth secret here. Since task 056
# the API is the only process that holds a database credential and the only host of
# better-auth (ADR-35 as amended 2026-07-31); the admin reaches both through the API,
# over the internal channel below. Sign-in, 2FA and session reads all travel that way,
# and the browser still only ever talks to this app's origin - no CORS surface exists.

# This app's own public origin. Two things read it: the SEC-9 origin check on every
# state-changing POST here, and better-auth's `baseURL`/`trustedOrigins` in the API,
# which is why the API's environment carries the same variable. No trailing slash.
#
# 7S40 is the admin's allocated dev port (docs/PORTS.md). Next's own default is
# 3000, so start the admin with `--port 7040` to match this value.
QCMS_ADMIN_BASE_URL=http://localhost:7040

# The internal API base URL (server-only). The API container is never published
# (ADR-20); only the admin's BFF reaches it. No trailing slash needed.
QCMS_API_BASE_URL=http://127.0.0.1:7010

# The SEC-4 internal service token presented on every API call (>= 32 chars).
# Must match one of the API's QCMS_INTERNAL_TOKEN values.
QCMS_INTERNAL_TOKEN=replace-with-a-32-char-plus-internal-token

# Whether the cookies this app sets carry `Secure`. Unset means NODE_ENV === production,
# which is what a built image gives you. The API reads the same variable for better-auth's
# session and two-factor cookies, and the two MUST agree: they are cookies on one origin,
# so a browser that keeps one family and drops the other turns enrolment into a redirect
# loop rather than a degraded experience. Set false only for plain HTTP on a non-loopback
# hostname (loopback is a trustworthy origin, so Secure works there).
# QCMS_ADMIN_SECURE_COOKIES=false

# Admin TOTP 2FA policy (SEC-1). Default (unset) = required, which is the only
# supported production value. `optional` is the documented DEVELOPMENT escape
# hatch: it lets an admin skip enrollment entirely. The API reads the same var,
# so relax it in both places or not at all.
# QCMS_ADMIN_2FA=optional

# Absolute admin-session lifetime in ms (SEC-1 default: 12h), measured from when the
# session was issued, so activity cannot extend it. The API reads the same variable
# and applies the same cap to every proxied call; keep them in step (whichever is
# shorter wins, and neither side can extend the other).
#
# The IDLE window (QCMS_ADMIN_SESSION_IDLE_MS, default 1h) is better-auth's, so it is
# configured where better-auth runs: the API's environment, not this one.
# QCMS_ADMIN_SESSION_MAX_AGE_MS=43200000

# The respondent theme this deployment serves (task 051, ADR-30). The PORTAL reads this
# same variable to pick what respondents actually see; the admin reads it so the preview
# opens in that theme rather than in this app's own Cobalt. The name is deliberately
# identical on both sides - it is one deployment fact, supplied to both services by
# composition, and a second spelling here would let the two disagree silently.
#
# One of: slate | harbor | sand | plum. Unset, blank or unrecognized falls back to slate,
# the shipped brand-neutral base, which is exactly what the portal does with it.
#
# It changes NOTHING about this app's own appearance: the authoring app is never
# adopter-themeable (ADR-26), and this value reaches only the preview container.
# QCMS_PORTAL_THEME=slate

# First-run bootstrap (`pnpm qcms:create-admin`) is an API-side command now, so its
# QCMS_ADMIN_EMAIL / QCMS_ADMIN_PASSWORD / QCMS_ADMIN_NAME variables belong to the
# API's environment. See apps/admin/README.md for the invocation.

# Agent-assisted form building (task 041, flag-gated, off the launch gate). Mirrors
# the API's own flag: any value other than "none" (or unset) renders the assist panel
# in the builder and mounts this app's streaming proxy route. The provider, model and
# API key are the API's own configuration (QCMS_AGENT_MODEL, QCMS_AGENT_API_KEY) - this
# app never holds a provider credential.
# QCMS_FLAG_AGENT_AUTHORING=none
