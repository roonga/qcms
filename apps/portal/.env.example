# QCMS portal - server-only configuration (task 029).
# The portal is a strict BFF: these values stay on the server and never reach the
# client bundle. Copy to .env.local for local development.

# The internal API base URL (server-only). The API container is never published
# (ADR-20); only the portal's BFF reaches it. No trailing slash needed.
QCMS_API_BASE_URL=http://127.0.0.1:3000

# The SEC-4 internal service token presented on every API call (>= 32 chars).
# Must match one of the API's QCMS_INTERNAL_TOKEN values.
QCMS_INTERNAL_TOKEN=replace-with-a-32-char-plus-internal-token

# Pre-session challenge provider (ADR-24, SEC-9). Default (unset) = none: no
# challenge code loads and the CSP names no challenge origin. Set to `turnstile`
# to render the Cloudflare Turnstile widget on entry pages.
# QCMS_FLAG_CHALLENGE_PROVIDER=turnstile

# The public Turnstile site key (only used when the flag above is `turnstile`).
# QCMS_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------
# Per-deployment theming (ADR-30; full contract in docs/theming.md). All of these
# are optional; an unrecognized value falls back to the default shown first.
# ---------------------------------------------------------------------------

# Which predefined theme this deployment runs: slate (Slate Teal, the shipped
# brand-neutral default) | harbor (corporate blue) | sand (warm neutral) |
# plum (deep violet). Each is authored in Light and Dark and shares the one
# High-contrast mode layer.
# QCMS_PORTAL_THEME=slate

# Corner preset (brand character): subtle (default) | sharp | rounded | pill.
# QCMS_PORTAL_CORNERS=subtle

# Default colour mode: auto (follow the respondent's OS preference) | light |
# dark | hc (High-contrast, AAA body text). Respondent-facing switching is
# task 053; until then `?mode=light|dark|hc` and the `qcms-theme` cookie are the
# manual override.
# QCMS_PORTAL_MODE=auto

# Default font, as a key from the @qcms/ui registry: system (the device's own UI
# face, the shipped default) plus atkinson | lexend | opendyslexic | inter |
# roboto | opensans | lato | poppins | montserrat | andika | fredoka | baloo2 |
# comicneue | patrickhand | merriweather | lora | ptserif | librebaskerville |
# ibmplexserif | publicsans | jetbrainsmono | geistmono. Every one is self-hosted,
# so no value here causes an external request. A key that is unknown, or curated
# out by QCMS_PORTAL_FONTS below, falls back to system.
# QCMS_PORTAL_FONT=system

# Which fonts this deployment OFFERS respondents (the operator's curation; the
# admin UI over the same setting is Phase-4). A list of registry keys separated by
# commas and/or spaces. Unset or empty offers the whole registry; unknown keys are
# ignored; `system` is always offered and cannot be removed. The list has no
# visible effect until task 053 renders the respondent font control from it.
# QCMS_PORTAL_FONTS=system,atkinson,lexend,opendyslexic,inter,merriweather
