# Server-only BFF configuration. Copy to .env.local for local development; never commit secrets.

# Internal API origin. Keep the API container unpublished; only the BFF reaches this address.
# pnpm dev:portal uses the allocated API dev port 7010; see docs/PORTS.md.
QCMS_API_BASE_URL=http://127.0.0.1:7010

# At least 32 characters; must match one of the API's QCMS_INTERNAL_TOKEN values.
QCMS_INTERNAL_TOKEN=replace-with-a-32-char-plus-internal-token

# Default none loads no challenge code or challenge CSP origin. Turnstile enables its entry-page widget.
# QCMS_FLAG_CHALLENGE_PROVIDER=turnstile

# Public site key, used only with Turnstile. Set the same value in API and portal.
# The API accepts deprecated TURNSTILE_SITE_KEY with a warning; use the QCMS-prefixed name.
# QCMS_TURNSTILE_SITE_KEY=

# BCP 47 formatting locale, default en-GB; copy stays English. Match the admin for preview fidelity.
# Also controls scriptless date order. Invalid tags or unavailable Intl data refuse boot without echoing the value.
# QCMS_LOCALE=en-GB

# Optional theming; unknown values fall back to defaults. Full contract: docs/theming.md.

# Theme: slate (default, neutral teal) | harbor (blue) | sand (warm neutral) | plum (violet).
# Each has light and dark palettes and shares the high-contrast layer.
# QCMS_PORTAL_THEME=slate

# Corners: subtle (default) | sharp | rounded | pill.
# QCMS_PORTAL_CORNERS=subtle

# Mode: auto (default, follows OS) | light | dark | hc (high contrast, AAA body text).
# The qcms-theme cookie and ?mode=light|dark|hc provide respondent overrides.
# QCMS_PORTAL_MODE=auto

# Default font registry key; system uses the device UI face. Every font is self-hosted.
# Unknown keys, or keys excluded by QCMS_PORTAL_FONTS, fall back to system.
# See docs/theming.md for the full font registry.
# QCMS_PORTAL_FONT=system

# Offered fonts: comma- or space-separated registry keys. Unset or empty offers the entire registry.
# Unknown keys are ignored; system is always offered. This curates the respondent font control.
# QCMS_PORTAL_FONTS=system,atkinson,lexend,opendyslexic,inter,merriweather
