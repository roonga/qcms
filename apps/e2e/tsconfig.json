// The full-stack smoke suite's own project (task 036).
//
// `apps/e2e/` holds no application source: it is one Playwright spec plus the
// module that reads the stack's two base URLs. It still needs a manifest and a
// project, because a directory without them is not a workspace package, so
// `turbo run lint` and `turbo run typecheck` skip it and the only gate that ever
// sees the spec is `prettier --check`. That is what this pair restores.
//
// The options mirror `apps/admin/tsconfig.json` and `apps/portal/tsconfig.json`
// deliberately (minus the Next plugin, the JSX settings and the `@/*` paths,
// none of which apply to a suite with no React and no app routes): the spec
// imports the admin's and the portal's e2e helpers directly, so it should be
// checked under the same options those helpers are checked under, or a shape
// that passes here could fail in its own package.
//
// Following those imports is also why `@qcms/db` is a devDependency of a package
// that never names it: `../admin/e2e/support/flow.js` reaches
// `apps/admin/lib/server/db.ts`, so this typecheck consumes `@qcms/db`'s BUILT
// declarations. Declaring it is what puts `@qcms/db#build` ahead of
// `qcms-e2e#typecheck` in turbo's graph; without it a clean tree typechecks this
// package before those declarations exist and fails with TS2307.
{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "incremental": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
