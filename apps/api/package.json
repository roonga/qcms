{
  "name": "qcms-api",
  "version": "0.0.0",
  "private": true,
  "description": "qcms API composition root (Hono, vertical slices), task 017",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. --project qcms-api --project qcms-api-e2e",
    "lint": "node ../../scripts/eslint-workspace.mjs src e2e scripts",
    "start": "node dist/serve.js",
    "create-admin": "node dist/create-admin.js",
    "reset-2fa": "node dist/reset-2fa.js",
    "seed-fixtures": "node scripts/seed-fixtures.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.81",
    "@ai-sdk/google": "^4.0.98",
    "@ai-sdk/openai": "^4.0.95",
    "@ai-sdk/openai-compatible": "^3.0.70",
    "@hono/node-server": "^2.1.5",
    "@hono/otel": "^1.2.0",
    "@hono/zod-openapi": "^1.6.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-pg": "^0.76.0",
    "@opentelemetry/instrumentation-undici": "^0.33.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/sdk-trace": "^2.12.0",
    "@roonga/qcms-a2ui-compiler": "workspace:*",
    "@roonga/qcms-core": "workspace:*",
    "@roonga/qcms-csv": "workspace:*",
    "@roonga/qcms-db": "workspace:*",
    "@roonga/qcms-observability": "workspace:*",
    "ai": "^7.0.142",
    "better-auth": "1.7.10",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "^2.11.0",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "otplib": "^13.5.0"
