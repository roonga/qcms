---
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex">
  <svg
    class="qcms-mark"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 32 32"
    fill="none"
    role="img"
    aria-label="QCMS"
  >
    <rect width="32" height="32" rx="7" fill="#2456c6"></rect>
    <circle cx="15" cy="15" r="6.5" stroke="#ffffff" stroke-width="2.5"></circle>
    <line
      x1="18.5"
      y1="18.5"
      x2="23"
      y2="23"
      stroke="#ffffff"
      stroke-width="2.5"
      stroke-linecap="round"></line>
  </svg>
  <span class="qcms-wordmark" translate="no">QCMS</span>
  <span class="qcms-tag qcms-site-tag">Docs</span>
</a>

<style>
  .site-title {
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
  }

  .qcms-mark {
    height: 1.5rem;
    width: 1.5rem;
    flex-shrink: 0;
    border-radius: var(--qcms-radius-control);
  }

  .qcms-wordmark {
    font-size: var(--sl-text-lg);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--qcms-text);
    overflow: hidden;
  }

  .qcms-site-tag {
    flex-shrink: 0;
  }

  @media (max-width: 30rem) {
    .qcms-site-tag {
      display: none;
    }
  }
</style>
