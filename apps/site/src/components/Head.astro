---
import Default from "@astrojs/starlight/components/Head.astro";
---

<Default><slot /></Default>

<script>
  // Content that scrolls is unreachable without a pointer unless it can take focus
  // (WCAG 2.1.1). A table keeps its own role, so it takes focus and nothing else.
  const SCROLLERS: ReadonlyArray<{ selector: string; label?: string }> = [
    { selector: ".expressive-code pre", label: "Code block" },
    { selector: ".qcms-chip", label: "Clone command" },
    { selector: ".sl-markdown-content table" },
  ];

  function markScrollable(): void {
    for (const { selector, label } of SCROLLERS) {
      document.querySelectorAll<HTMLElement>(selector).forEach((el) => {
        const scrolls = el.scrollWidth > el.clientWidth || el.scrollHeight > el.clientHeight;
        if (!scrolls) {
          el.removeAttribute("tabindex");
          el.removeAttribute("role");
          el.removeAttribute("aria-label");
          return;
        }
        el.setAttribute("tabindex", "0");
        if (label === undefined) return;
        // `group`, not `region`: a region is a landmark, and several identically named
        // landmarks on one page is itself a failure.
        el.setAttribute("role", "group");
        el.setAttribute("aria-label", `${label}, scrollable`);
      });
    }
  }

  markScrollable();
  addEventListener("resize", markScrollable);
</script>
