{
  "name": "qcms",
  "version": "0.0.1-alpha.0",
  "private": true,
  "description": "QCMS: dynamic questionnaires",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "verify": "pnpm check:all && pnpm build && pnpm typecheck && pnpm lint && pnpm test && pnpm test:golden-drift",
    "verify:browser": "playwright test",
    "docker:up": "node scripts/compose-e2e.mjs up",
    "docker:down": "node scripts/compose-e2e.mjs down",
    "test:e2e": "node scripts/compose-e2e.mjs test",
    "test:e2e:headed": "node scripts/compose-e2e.mjs test-headed",
    "up:e2e": "node scripts/compose-e2e.mjs run",
    "up:e2e:headed": "node scripts/compose-e2e.mjs run-headed",
    "check:all": "pnpm check:no-em-dash && pnpm check:no-control-chars && pnpm check:harness-tags && pnpm check:paths && pnpm check:ports && pnpm check:security-hygiene && pnpm check:vendor-pin && pnpm check:a2ra-fidelity && pnpm check:adr-citations && pnpm check:changeset && pnpm check:golden-append-only && pnpm check:licenses && pnpm check:duplication && pnpm check:admin-theme && pnpm check:lint-coverage && pnpm check:tailwind-sources && pnpm check:docker-job-guards && pnpm check:ci-parity && pnpm check:templates",
    "check:plan": "pnpm check:no-control-chars && pnpm check:harness-tags && pnpm check:security-hygiene && pnpm check:admin-theme && eslint plan && prettier --check plan",
    "dev:up": "node scripts/dev-compose.mjs up",
    "dev:down": "node scripts/dev-compose.mjs down",
    "dev:seed": "node scripts/dev-compose.mjs seed",
    "dev:portal": "node scripts/dev-portal.mjs",
    "dev:admin": "node scripts/dev-admin.mjs",
    "artifacts": "node scripts/serve-artifacts.mjs",
    "qcms:build-images": "node scripts/build-images.mjs",
    "qcms:drill-restore": "node scripts/drill-restore.mjs",
    "qcms:create-admin": "pnpm --filter qcms-api... build && pnpm --filter qcms-api create-admin",
    "qcms:seed-fixtures": "pnpm --filter qcms-api seed-fixtures",
    "devcontainer": "bash scripts/devcontainer.sh",
    "claude": "bash scripts/claude-session.sh",
    "agent-loop:status": "node scripts/agent-loop-status.mjs",
    "worktrees:prune": "node scripts/prune-worktrees.mjs",
    "test": "turbo run test && pnpm test:tooling",
    "test:tooling": "vitest run --project tooling",
    "env-arrival": "node scripts/print-passthrough-env.mjs",
    "test:golden-drift": "vitest run --project @roonga/qcms-core packages/core/src/golden-corpus.test.ts",
    "check:golden-append-only": "node scripts/check-golden-append-only.mjs",
    "typecheck": "turbo run typecheck",
    "lint": "eslint scripts .devcontainer plan eslint.config.js vitest.config.ts playwright.config.ts playwright.compose.config.ts packages/db/drizzle.config.ts packages/ui/vitest.config.ts packages/ui/vitest.setup.ts && turbo run lint && prettier --check . && node scripts/check-fixture-domain.mjs",
    "check:fixture-domain": "node scripts/check-fixture-domain.mjs",
    "format": "prettier --write .",
    "changeset": "changeset",
    "check:no-control-chars": "node scripts/check-no-control-chars.mjs",
    "openapi:generate": "pnpm --filter qcms-api build && node apps/api/scripts/generate-openapi.mjs",
    "openapi:check": "vitest run --project qcms-api openapi-document.test.ts",
    "check:changeset": "node scripts/check-changeset.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:no-em-dash": "node scripts/check-no-em-dash.mjs",
    "check:ports": "node scripts/check-ports.mjs",
    "check:security-hygiene": "node scripts/check-security-hygiene.mjs",
    "check:vendor-pin": "node scripts/check-vendor-pin.mjs",
    "check:admin-theme": "node scripts/check-admin-theme.mjs",
    "check:lint-coverage": "node scripts/check-lint-coverage.mjs",
    "check:harness-tags": "node scripts/check-harness-tags.mjs",
    "check:paths": "node scripts/check-paths.mjs",
    "check:a2ra-fidelity": "node scripts/check-a2ra-fidelity.mjs",
    "check:adr-citations": "node scripts/check-adr-citations.mjs",
    "check:tailwind-sources": "node scripts/check-tailwind-sources.mjs",
    "check:docker-job-guards": "node scripts/check-docker-job-guards.mjs",
    "check:ci-parity": "node scripts/check-ci-parity.mjs",
    "check:templates": "node packages/create-qcms-app/scripts/sync-templates.mjs --check",
    "qcms:sync-templates": "node packages/create-qcms-app/scripts/sync-templates.mjs --write",
    "qcms:scaffold-e2e": "node packages/create-qcms-app/scripts/scaffold-e2e.mjs",
    "check:duplication": "jscpd packages apps --config .jscpd.json --threshold 3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@changesets/cli": "^3.0.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "4.1.11",
    "chrome-launcher": "^1.2.1",
    "eslint": "^10.9.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "jscpd": "^5.1.1",
    "lighthouse": "^13.4.1",
    "otplib": "^13.5.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
