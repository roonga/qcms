{
  "$schema": "https://turbo.build/schema.json",
  // Do not let an upstream tool maintain repository-scoped agent instructions.
  "agentGuidance": false,
  // Every lint task calls the root wrapper; hash it so wrapper edits invalidate cached lint verdicts.
  "globalDependencies": [
    "eslint.config.js",
    "scripts/eslint-workspace.mjs",
    ".prettierrc*",
    "tsconfig.base.json"
  ],
  // Task concurrency multiplies with each Vitest worker pool; pair the budgets.
  "concurrency": "50%",
  // Pass execution-location controls without hashing identical outputs.
  // Do not pass OTEL_* into unit tests: a developer endpoint must not enable exports inside the suite.
  "globalPassThroughEnv": [
    "QCMS_PORT_SEAT",
    "QCMS_TEST_POSTGRES_IMAGE",
    "QCMS_TEST_MAILPIT_IMAGE",
    "TESTCONTAINERS_RYUK_DISABLED",
    "RYUK_CONTAINER_IMAGE",
    "TESTCONTAINERS_HOST_OVERRIDE",
    "DOCKER_HOST",
    "DOCKER_CONFIG",
    "DOCKER_AUTH_CONFIG"
  ],
  "tasks": {
    // Never replay environment diagnostics from a different process.
    "//#env-arrival": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    // Never restore .next/dev or .next/cache over live local state.
    // The extra build edges cover transitive API-harness imports during Next typechecking.
    "qcms-portal#build": {
      "dependsOn": [
        "^build",
        "@roonga/qcms-db#build",
        "@roonga/qcms-a2ui-compiler#build",
        "@roonga/qcms-csv#build"
      ],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    // Next writes .next rather than the generic dist output; retain the same cache exclusions as the portal.
    "qcms-admin#build": {
      "dependsOn": ["^build", "@roonga/qcms-db#build", "@roonga/qcms-a2ui-compiler#build"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    // This test scans its importers, which dependency edges cannot reach.
    // Hash the scanned source trees as well as the package defaults to prevent stale green results.
    "@roonga/qcms-observability#test": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/*/src/**",
        "$TURBO_ROOT$/apps/*/lib/**",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/packages/*/lib/**"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    // Typed ESLint resolves workspace declaration files, so dependency builds must finish first.
    "lint": {
      "dependsOn": ["^build"]
    },
    // The admin harness imports API source and its database/compiler declarations transitively.
    // Build those declarations without adding database dependencies to the frontend manifest.
    "qcms-admin#typecheck": {
      "dependsOn": ["^build", "@roonga/qcms-db#build", "@roonga/qcms-a2ui-compiler#build"]
    },
    "qcms-admin#lint": {
      "dependsOn": ["^build", "@roonga/qcms-db#build", "@roonga/qcms-a2ui-compiler#build"]
    },
    // The portal harness imports API source and its database/compiler/CSV declarations transitively.
    // Build those declarations without adding database dependencies to the frontend manifest.
    "qcms-portal#typecheck": {
      "dependsOn": [
        "^build",
        "@roonga/qcms-db#build",
        "@roonga/qcms-a2ui-compiler#build",
        "@roonga/qcms-csv#build"
      ]
    },
    "qcms-portal#lint": {
      "dependsOn": [
        "^build",
        "@roonga/qcms-db#build",
        "@roonga/qcms-a2ui-compiler#build",
        "@roonga/qcms-csv#build"
      ]
    },
    // The full-stack harness reaches CSV and observability through frontend/API source rather than declared dependencies.
    "qcms-e2e#typecheck": {
      "dependsOn": ["^build", "@roonga/qcms-csv#build", "@roonga/qcms-observability#build"]
    },
    "qcms-e2e#lint": {
      "dependsOn": ["^build", "@roonga/qcms-csv#build", "@roonga/qcms-observability#build"]
    }
  }
}
