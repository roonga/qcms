{
  "openapi": "3.0.3",
  "info": {
    "title": "qcms respondent API",
    "version": "0.0.0",
    "description": "The public respondent loop: start a session, walk the branching flow, submit. Plus the always-on liveness/readiness probes."
  },
  "x-stability": "internal",
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "ReadyResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "unavailable"
            ]
          },
          "checks": {
            "type": "object",
            "properties": {
              "db": {
                "type": "string",
                "enum": [
                  "ok",
                  "down"
                ]
              }
            },
            "required": [
              "db"
            ]
          }
        },
        "required": [
          "status",
          "checks"
        ]
      },
      "StartSessionResponse": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "example": "ses_9f3a2b1c"
          },
          "sessionToken": {
            "type": "string"
          },
          "formVersion": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true,
            "example": 1
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-07-21T00:00:00.000Z"
          }
        },
        "required": [
          "sessionId",
          "sessionToken",
          "formVersion",
          "expiresAt"
        ]
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "unauthorized"
              },
              "message": {
                "type": "string",
                "example": "Missing or invalid internal service token"
              },
              "details": {
                "nullable": true
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "StartSessionBody": {
        "type": "object",
        "properties": {
          "formSlug": {
            "type": "string",
            "minLength": 1,
            "description": "Public form slug for anonymous entry.",
            "example": "customer-feedback"
          },
          "token": {
            "type": "string",
            "minLength": 1,
            "description": "Secure-link token for invited entry."
          },
          "challengeToken": {
            "type": "string",
            "description": "Challenge solution (e.g. Turnstile token) for a form with challengeRequired set. Verified by the configured provider; ignored when the provider is `none` (task 026)."
          }
        },
        "additionalProperties": false
      },
      "SessionStatusResponse": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "example": "ses_9f3a2b1c"
          },
          "status": {
            "type": "string",
            "enum": [
              "created",
              "in_progress",
              "submitted",
              "expired"
            ]
          },
          "formVersion": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "position": {
            "nullable": true,
            "description": "Reserved for the current flow position (filled by 019)."
          }
        },
        "required": [
          "sessionId",
          "status",
          "formVersion",
          "expiresAt",
          "position"
        ]
      },
      "StepResponse": {
        "type": "object",
        "properties": {
          "step": {
            "$ref": "#/components/schemas/StepDocument"
          },
          "values": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^opt_[a-z0-9_]+$"
                  }
                }
              ]
            },
            "description": "The answers the server currently holds for this step's visible questions, keyed by questionId, in canonical AnswerValue encoding (an NFC string for shortText, longText, date and singleChoice; a finite number; a boolean; a duplicate-free array of optionIds for multiChoice). Absent keys are unanswered (including retracted answers), and a value is never null. Display data only; the flow projection stays the sole authority on visibility and readiness.",
            "example": {
              "q_at_fault_accident": true,
              "q_accident_count": 2
            }
          },
          "a2uiSpecVersion": {
            "type": "string",
            "description": "The pinned snapshot's A2UI spec version, so the renderer selects the right handling (ADR-18).",
            "example": "1.0.0-preview.7"
          },
          "flowState": {
            "$ref": "#/components/schemas/FlowStateProjection"
          },
          "rosters": {
            "$ref": "#/components/schemas/RosterProjection"
          },
          "view": {
            "$ref": "#/components/schemas/StepViewProjection"
          },
          "progress": {
            "$ref": "#/components/schemas/StepProgress"
          }
        },
        "required": [
          "step",
          "values",
          "a2uiSpecVersion",
          "flowState",
          "rosters",
          "view",
          "progress"
        ]
      },
      "StepDocument": {
        "type": "object",
        "nullable": true,
        "properties": {
          "stepId": {
            "type": "string",
            "example": "stp_history"
          },
          "root": {
            "nullable": true
          }
        },
        "required": [
          "stepId"
        ]
      },
      "FlowStateProjection": {
        "type": "object",
        "properties": {
          "currentStep": {
            "type": "string",
            "nullable": true,
            "example": "stp_history"
          },
          "visibleQuestions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The currently-visible fields of the rendered step, as ANSWER KEYS: a bare questionId outside every repeating group, and `instanceId/questionId` inside one (ADR-42, ADR-43). A rule targeting inside a group is evaluated once per live instance, so a member question can be visible in one instance and hidden in another and only the qualified key can say which.",
            "example": [
              "q_at_fault_accident",
              "q_accident_count"
            ]
          },
          "missingRequired": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The visible required fields still unanswered, as answer keys, on the same rule as visibleQuestions: one entry per unanswered (instance, question) inside a group rather than one per question.",
            "example": [
              "q_accident_count"
            ]
          },
          "readyToSubmit": {
            "type": "boolean",
            "description": "True when no visible required question is unanswered (the flow may be submitted)."
          }
        },
        "required": [
          "currentStep",
          "visibleQuestions",
          "missingRequired",
          "readyToSubmit"
        ]
      },
      "RosterProjection": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "groupId": {
              "type": "string",
              "example": "grp_passengers"
            },
            "instances": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "example": [
                "ins_7k2",
                "ins_9m4"
              ]
            }
          },
          "required": [
            "groupId",
            "instances"
          ]
        }
      },
      "StepViewProjection": {
        "type": "object",
        "properties": {
          "groupId": {
            "type": "string",
            "nullable": true,
            "example": "grp_vehicles"
          },
          "instanceId": {
            "type": "string",
            "nullable": true,
            "example": "ins_7k2"
          }
        },
        "required": [
          "groupId",
          "instanceId"
        ]
      },
      "StepProgress": {
        "type": "object",
        "properties": {
          "stepIndex": {
            "type": "integer",
            "description": "0-based index of the current step VIEW within the visible step views; equals totalVisibleSteps when complete."
          },
          "totalVisibleSteps": {
            "type": "integer",
            "example": 1
          }
        },
        "required": [
          "stepIndex",
          "totalVisibleSteps"
        ]
      },
      "SubmitAnswerBody": {
        "type": "object",
        "properties": {
          "questionId": {
            "type": "string",
            "minLength": 1,
            "example": "q_at_fault_accident"
          },
          "instanceId": {
            "type": "string",
            "minLength": 1,
            "description": "Which instance of a repeating group this answer belongs to (ADR-42). Absent for a question outside every group, which keeps the body byte-identical for every form that has none. A retraction names an instance too, and clears that cell alone (ADR-33's Note).",
            "example": "ins_7k2"
          },
          "value": {
            "nullable": true,
            "description": "The answer value; validated against the pinned question. Literal null retracts the answer (the question becomes unanswered; the ledger records the retraction). An empty value (\"\" or []) is not an answer and is rejected with EMPTY_ANSWER_NOT_ALLOWED; send null to clear an answer."
          }
        },
        "required": [
          "questionId"
        ],
        "additionalProperties": false
      },
      "BatchAnswerResponse": {
        "type": "object",
        "properties": {
          "step": {
            "$ref": "#/components/schemas/StepDocument"
          },
          "values": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^opt_[a-z0-9_]+$"
                  }
                }
              ]
            },
            "description": "The answers the server currently holds for this step's visible questions, keyed by questionId, in canonical AnswerValue encoding (an NFC string for shortText, longText, date and singleChoice; a finite number; a boolean; a duplicate-free array of optionIds for multiChoice). Absent keys are unanswered (including retracted answers), and a value is never null. Display data only; the flow projection stays the sole authority on visibility and readiness.",
            "example": {
              "q_at_fault_accident": true,
              "q_accident_count": 2
            }
          },
          "a2uiSpecVersion": {
            "type": "string"
          },
          "flowState": {
            "$ref": "#/components/schemas/FlowStateProjection"
          },
          "rosters": {
            "$ref": "#/components/schemas/RosterProjection"
          },
          "view": {
            "$ref": "#/components/schemas/StepViewProjection"
          },
          "progress": {
            "$ref": "#/components/schemas/StepProgress"
          },
          "rejected": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BatchAnswerRejection"
            }
          }
        },
        "required": [
          "step",
          "values",
          "a2uiSpecVersion",
          "flowState",
          "rosters",
          "view",
          "progress",
          "rejected"
        ]
      },
      "BatchAnswerRejection": {
        "type": "object",
        "properties": {
          "questionId": {
            "type": "string"
          },
          "instanceId": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "example": "INVALID_ANSWER"
          },
          "details": {
            "nullable": true
          }
        },
        "required": [
          "questionId",
          "code"
        ]
      },
      "BatchAnswerBody": {
        "type": "object",
        "properties": {
          "answers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SubmitAnswerBody"
            },
            "minItems": 1,
            "maxItems": 2000,
            "description": "The step's answers, in the order the form asked them. Each entry is exactly a single-answer body, including the null retraction and the optional instanceId."
          }
        },
        "required": [
          "answers"
        ],
        "additionalProperties": false
      },
      "RosterOpResponse": {
        "type": "object",
        "properties": {
          "step": {
            "$ref": "#/components/schemas/StepDocument"
          },
          "values": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^opt_[a-z0-9_]+$"
                  }
                }
              ]
            },
            "description": "The answers the server currently holds for this step's visible questions, keyed by questionId, in canonical AnswerValue encoding (an NFC string for shortText, longText, date and singleChoice; a finite number; a boolean; a duplicate-free array of optionIds for multiChoice). Absent keys are unanswered (including retracted answers), and a value is never null. Display data only; the flow projection stays the sole authority on visibility and readiness.",
            "example": {
              "q_at_fault_accident": true,
              "q_accident_count": 2
            }
          },
          "a2uiSpecVersion": {
            "type": "string"
          },
          "flowState": {
            "$ref": "#/components/schemas/FlowStateProjection"
          },
          "rosters": {
            "$ref": "#/components/schemas/RosterProjection"
          },
          "view": {
            "$ref": "#/components/schemas/StepViewProjection"
          },
          "progress": {
            "$ref": "#/components/schemas/StepProgress"
          },
          "replayed": {
            "type": "boolean"
          },
          "minted": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "step",
          "values",
          "a2uiSpecVersion",
          "flowState",
          "rosters",
          "view",
          "progress",
          "replayed",
          "minted"
        ]
      },
      "RosterOpBody": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "add",
              "remove"
            ],
            "example": "add"
          },
          "groupId": {
            "type": "string",
            "minLength": 1,
            "example": "grp_passengers"
          },
          "instanceId": {
            "type": "string",
            "minLength": 1,
            "description": "Required for `remove`; refused for `add`.",
            "example": "ins_7k2"
          },
          "opToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "The one-time operation token this page minted. A token already applied is a no-op that returns the current roster.",
            "example": "op_7f3a2b1c"
          }
        },
        "required": [
          "op",
          "groupId",
          "opToken"
        ],
        "additionalProperties": false
      },
      "SubmitResponse": {
        "type": "object",
        "properties": {
          "submittedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-07-20T00:00:00.000Z"
          },
          "contentHash": {
            "type": "string",
            "description": "Lowercase-hex SHA-256 over the canonical locked submission (the audit anchor).",
            "example": "3b0c…"
          }
        },
        "required": [
          "submittedAt",
          "contentHash"
        ]
      },
      "SubmitBody": {
        "type": "object",
        "properties": {
          "website": {
            "type": "string",
            "description": "Honeypot field; must be empty. A non-empty value is flagged."
          }
        },
        "additionalProperties": {
          "nullable": true
        }
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness probe",
        "tags": [
          "ops"
        ],
        "responses": {
          "200": {
            "description": "Process is up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "Readiness probe (checks the database)",
        "tags": [
          "ops"
        ],
        "responses": {
          "200": {
            "description": "Dependencies reachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            }
          },
          "503": {
            "description": "A dependency is unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/sessions": {
      "post": {
        "summary": "Start a respondent session (anonymous or via a secure link)",
        "tags": [
          "responses"
        ],
        "security": [
          {
            "MachineToken": [
              "responses:write"
            ]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartSessionBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Session created; the token authorizes every later respondent call",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartSessionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{id}": {
      "get": {
        "summary": "Read a session's status and pinned version (session-token authed)",
        "tags": [
          "responses"
        ],
        "security": [
          {
            "MachineToken": [
              "responses:read"
            ]
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "ses_9f3a2b1c"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The session's current status view",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionStatusResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{id}/step": {
      "get": {
        "summary": "Serve a step's stored compiled UI and flow projection (session-token authed)",
        "tags": [
          "responses"
        ],
        "security": [
          {
            "MachineToken": [
              "responses:read"
            ]
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "ses_9f3a2b1c"
            },
            "required": true,
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "integer",
              "nullable": true,
              "minimum": 0,
              "description": "0-based index of the visible step to render (the explicit navigation cursor, ADR-28). Clamped to the visible range; omit to serve the first incomplete step.",
              "example": 1
            },
            "required": false,
            "description": "0-based index of the visible step to render (the explicit navigation cursor, ADR-28). Clamped to the visible range; omit to serve the first incomplete step.",
            "name": "step",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "The current step document and client-safe flow projection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StepResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{id}/answers": {
      "post": {
        "summary": "Submit one answer (or retract it with a null value); validated, appended to the ledger, flow re-evaluated (session-token authed)",
        "tags": [
          "responses"
        ],
        "security": [
          {
            "MachineToken": [
              "responses:write"
            ]
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "ses_9f3a2b1c"
            },
            "required": true,
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "integer",
              "nullable": true,
              "minimum": 0,
              "description": "0-based index of the visible step to render (the explicit navigation cursor, ADR-28). Clamped to the visible range; omit to serve the first incomplete step.",
              "example": 1
            },
            "required": false,
            "description": "0-based index of the visible step to render (the explicit navigation cursor, ADR-28). Clamped to the visible range; omit to serve the first incomplete step.",
            "name": "step",
            "in": "query"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitAnswerBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The answer was recorded; the updated flow projection follows",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StepResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
