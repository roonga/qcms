# Copy to .env before starting the solo Compose stack. Never commit .env.
# Generate every secret with a cryptographically secure generator; use at least 32 characters.
QCMS_DB_NAME=qcms
QCMS_DB_USER=qcms
QCMS_DB_PASSWORD=replace-with-a-strong-database-password

# The credential above bootstraps roles only; runtime services must use least-privilege roles.
# The migration role owns schema and DDL. Application roles have operational DML and sequence USAGE, not DDL.
# Use distinct strong passwords; db-roles rotates them on the next up. See docs/operations.md.
QCMS_DB_MIGRATE_PASSWORD=replace-with-a-strong-migration-role-password
# Keep control and environment passwords distinct so one role's credential cannot cross that boundary.
# Add a password and QCMS_DATABASE_URL_<ENV> for every additional environment.
QCMS_DB_APP_CONTROL_PASSWORD=replace-with-a-strong-control-role-password
QCMS_DB_APP_TEST_PASSWORD=replace-with-a-strong-test-role-password
QCMS_DB_APP_PROD_PASSWORD=replace-with-a-strong-prod-role-password

# Must match control.environments at API boot; disagreement refuses startup.
# Include prod. Automated suites also require test.
QCMS_ENVIRONMENTS=test,prod

QCMS_LINK_KEYS=replace-with-a-random-32-character-link-signing-key
QCMS_SESSION_KEYS=replace-with-a-random-32-character-session-signing-key
QCMS_INTERNAL_TOKEN=replace-with-a-random-32-character-internal-token

# AES-256-GCM key for stored webhook signing secrets. Set once and back up with the database.
# This scalar has no key id or in-place rotation: changing it makes existing secrets undecryptable
# and deliveries fail with secret_decrypt_failed until their secrets are reissued.

# Recover by rotating each form's webhook secret, sharing it with consumers out of band,
# then redelivering dead letters from the deployment-wide Webhooks area.
# This requires consumer coordination; see the App encryption key runbook in docs/operations.md.
QCMS_APP_KEY=replace-with-a-random-32-character-app-encryption-key

# The API alone holds better-auth's signing and encryption secret; the admin never receives it.
# Never replace it in place: both enrolled TOTP secrets and recovery codes become unreadable.
# Rotate with the versioned list below; see docs/operations.md, Admin auth secret rotation.
QCMS_ADMIN_AUTH_SECRET=replace-with-a-random-32-character-admin-auth-secret

# Optional rotation list: comma-separated <version>:<secret>, strictly descending, newest first.
# Each secret needs at least 32 characters. The first encrypts new material; older entries decrypt it.
# Unset uses version 1 with QCMS_ADMIN_AUTH_SECRET. Rotation signs administrators out once.

# Add versions without removing old ones: factors encrypted under a removed key become unreadable.
# Keep all keys backed up. Migration and recovery steps are in docs/operations.md.
# QCMS_ADMIN_AUTH_SECRETS=2:replace-with-the-new-admin-auth-secret,1:replace-with-the-current-admin-auth-secret

# Browser-facing origins: use your TLS ingress URLs in deployment.
# These are seat 0's long-running portal/admin slots; do not share them with pnpm dev:portal.
# Move both to another allocated 7Sxx pair if needed; see docs/PORTS.md.
QCMS_PORTAL_BASE_URL=http://localhost:7000
QCMS_ADMIN_BASE_URL=http://localhost:7040
QCMS_PORTAL_PORT=7000
QCMS_ADMIN_PORT=7040

# Loopback keeps published ports off the network. A separate ingress host needs 0.0.0.0
# plus a private network or forwarding-aware firewall: Docker forwarding bypasses INPUT-only rules.
QCMS_BIND_ADDRESS=127.0.0.1

# Unset uses production Secure cookies, including on trustworthy HTTP loopback origins.
# Set false only if a browser refuses Secure cookies on loopback; non-loopback downgrades refuse boot.
# Use TLS for real hostnames, or access the stack through a loopback tunnel.
# QCMS_SECURE_COOKIES=false

# Count actual trusted proxies from the right of X-Forwarded-For; overstating the count trusts client input
# and bypasses address-based limits. One fits the ingress recipes; read docs/deploy-ingress.md before stacking proxies.
# Direct access needs 0: no forwarded address is trusted, so all respondents share deployment-wide rate buckets.
QCMS_PORTAL_TRUSTED_PROXY_HOPS=1

# Non-prod routes use /<env>/ prefixes; prod is always served without a prefix.
# Empty serves prod only. Unlisted environments have no routes and return 404.
# Match the API's QCMS_MOUNT so a served address does not reach an unmounted API environment.
QCMS_PORTAL_ENVIRONMENTS=

# Comma-separated <env>=<host> pairs:
#   QCMS_PORTAL_ENVIRONMENT_HOSTS=test=test-forms.example.com
# These hosts disable anonymous /f/<slug> access; they do not confine /<env>/ paths to that hostname.
# Restrict the hostname at ingress with a network allowlist, VPN or identity proxy; see docs/deploy-ingress.md.
QCMS_PORTAL_ENVIRONMENT_HOSTS=

# Count the admin hostname's real proxy hops separately; never declare a proxy before installing it.
# Leave unset for this proxy-less stack. Set 0 for direct access; callers then share one sign-in throttle bucket.
# With no vouched address, API startup warns that one caller can temporarily throttle every administrator.
# QCMS_ADMIN_TRUSTED_PROXY_HOPS=1

# Both API and admin must use the same Secure-cookie policy or enrollment can loop when one family is dropped.
# Unset uses production Secure cookies, including on HTTP loopback. False on a non-loopback admin origin refuses boot.
# For plain HTTP evaluation, use a loopback tunnel and set QCMS_ADMIN_BASE_URL to that origin.
# QCMS_ADMIN_SECURE_COOKIES=false

# Password breach checking defaults on and sends only the first five SHA-1 hex characters over HTTPS.
# It fails closed when api.pwnedpasswords.com is unreachable, including during first-admin creation.
# Disable only for air-gapped operation or emergency rotation during an outage; API startup warns of the downgrade.
# QCMS_ADMIN_PASSWORD_BREACH_CHECK=false

# BCP 47 formatting locale, default en-GB; copy remains English. Portal and admin must agree for preview fidelity.
# Controls use it for dates, numbers and lists. Invalid tags or missing Intl data refuse boot without echoing the value.
# QCMS_LOCALE=en-GB

# Authoring is off unless a provider is configured. Set its model and key, then recreate API and admin containers.
# Only the flag reaches admin; provider credentials stay in the API. Never commit the key.
# Provider and local-model setup: docs/agent-authoring.md.
# QCMS_FLAG_AGENT_AUTHORING=anthropic
# QCMS_AGENT_MODEL=
# QCMS_AGENT_API_KEY=
# QCMS_AGENT_BASE_URL=
# QCMS_AGENT_MAX_STEPS=8
# Reasoning summary: off (default) or summary. Tokens are billed output; text is never logged or stored.
# QCMS_AGENT_THINKING=off

# Optional portal Server Action salt: a build argument when building docker/portal.Dockerfile, not a runtime setting.
# A stable key preserves action ids across deploys; otherwise a held scriptless repeating step can receive 409
# and lose values typed since Continue. Previously saved answers remain safe.

# Generate 32 base64 bytes with openssl rand -base64 32; store with your secrets and never commit it.
# The key is readable in the image's server manifest; pinning shares that exposure across builds.
# Unset gives a fresh key per build. See docs/deploy-ingress.md and docs/SECURITY_DESIGN.md.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
