# Copy to .env before starting the solo Compose stack. Generate every secret
# with a cryptographically secure generator; values must be at least 32 chars.
QCMS_DB_NAME=qcms
QCMS_DB_USER=qcms
QCMS_DB_PASSWORD=replace-with-a-strong-database-password

QCMS_LINK_KEYS=replace-with-a-random-32-character-link-signing-key
QCMS_SESSION_KEYS=replace-with-a-random-32-character-session-signing-key
QCMS_INTERNAL_TOKEN=replace-with-a-random-32-character-internal-token
QCMS_APP_KEY=replace-with-a-random-32-character-app-encryption-key
QCMS_ADMIN_AUTH_SECRET=replace-with-a-random-32-character-admin-auth-secret

# Browser-facing origins. Put the TLS ingress URLs here in a real deployment.
# The published ports are seat 0's stable portal and admin slots (docs/PORTS.md):
# this stack is long-running and human-facing, so it cannot share a seat with
# pnpm dev:portal. Move both to another seat's 7Sxx pair if it has to.
QCMS_PORTAL_BASE_URL=http://localhost:7000
QCMS_ADMIN_BASE_URL=http://localhost:7040
QCMS_PORTAL_PORT=7000
QCMS_ADMIN_PORT=7040

# Set true behind a TLS ingress. Local Compose is intentionally HTTP.
QCMS_SECURE_COOKIES=false
