# Copy to .env before starting the solo Compose stack. Generate every secret
# with a cryptographically secure generator; values must be at least 32 chars.
QCMS_DB_NAME=qcms
QCMS_DB_USER=qcms
QCMS_DB_PASSWORD=replace-with-a-strong-database-password

QCMS_LINK_KEYS=replace-with-a-random-32-character-link-signing-key
QCMS_SESSION_KEYS=replace-with-a-random-32-character-session-signing-key
QCMS_INTERNAL_TOKEN=replace-with-a-random-32-character-internal-token

# The AES-256-GCM key for secrets at rest. It encrypts exactly one thing: the
# per-webhook HMAC signing secret held in webhooks.secret_encrypted.
#
# SET IT ONCE, and back it up with the database. There is no in-place rotation and no
# re-encrypt job. This is a single scalar, not a list like QCMS_LINK_KEYS, and the
# stored envelope carries a scheme version ("v1.") but no key id, so nothing records
# which key encrypted a given row. Change this value and every stored webhook secret
# becomes undecryptable at once: deliveries fail with secret_decrypt_failed and
# dead-letter until the secrets are re-issued.
#
# That is NOT the category of loss QCMS_ADMIN_AUTH_SECRET below describes. This one is
# recoverable without the old key, because the webhook secret is server-generated and
# can be replaced without ever reading the old one: press "Rotate secret" on each
# form's Webhooks page in the admin, hand each consumer its new secret out of band,
# then redeliver the dead-lettered deliveries from the deployment-wide Webhooks area
# page in the main nav, which is where that queue lives rather than on the form. The
# cost is re-coordinating a shared secret with every webhook consumer, not losing data.
# Runbook: the "App encryption key" section of docs/operations.md.
QCMS_APP_KEY=replace-with-a-random-32-character-app-encryption-key

# better-auth's signing secret. Read by the API, which owns the instance since task
# 056; the admin service never sees it.
#
# NEVER CHANGE IT IN PLACE. It is the key the stored second factors are ENCRYPTED under,
# so editing this value does not merely end sessions, it makes every enrolled account
# unverifiable. Checked against better-auth 1.6.26's source, not inferred:
# `two-factor/enable` writes `symmetricEncrypt({ key: ctx.context.secretConfig, ... })`
# (dist/plugins/two-factor/index.mjs:105) and verification decrypts with the CURRENT key
# (dist/plugins/two-factor/totp/index.mjs:188, and :122 for the URI reveal).
#
# The recovery codes go with it. This file used to say they survive, because QCMS sets
# no `storeBackupCodes` and the default is plain JSON, and told you to sign in with a
# recovery code and re-bootstrap. Both halves were wrong: the plugin defaults
# `storeBackupCodes` to "encrypted" (dist/plugins/two-factor/index.mjs:25-27), so all ten
# (dist/plugins/two-factor/backup-codes/index.mjs:15, `amount ?? 10`) are ciphertext under
# this same key, and that recovery procedure could never have run (issue #319).
#
# What replaces it is QCMS_ADMIN_AUTH_SECRETS below: not the verify-with-any-key window
# QCMS_LINK_KEYS has, but a versioned set in which stored material carries the version
# that wrote it. See docs/SECURITY_DESIGN.md section 4 and the "Admin auth secret
# rotation" runbook in docs/operations.md.
QCMS_ADMIN_AUTH_SECRET=replace-with-a-random-32-character-admin-auth-secret

# Versioned admin auth keys, for rotating the value above without destroying what it
# protects (SEC-7, issue #319). Comma-separated `<version>:<secret>` entries, newest
# first, each held to the same 32-character floor. The first entry encrypts everything
# written from now on and the rest stay readable; the API refuses to start on a list
# that is not in descending version order.
#
# Leave it commented out unless you are rotating. Unset, the API runs a single version-1
# entry holding QCMS_ADMIN_AUTH_SECRET, which is exactly what this stack did before.
# Rotating signs every administrator out once, and that is the whole visible impact.
# Keep the older versions listed: a TOTP secret written under a retired version stops
# being readable the moment that version leaves the list, and there is no re-enrolment
# screen at launch (issue #432). Add versions, do not remove them. What migrates forward
# on its own and what does not: docs/operations.md.
# QCMS_ADMIN_AUTH_SECRETS=2:replace-with-the-new-admin-auth-secret,1:replace-with-the-current-admin-auth-secret

# Browser-facing origins. Put the TLS ingress URLs here in a real deployment.
# The published ports are seat 0's stable portal and admin slots (docs/PORTS.md):
# this stack is long-running and human-facing, so it cannot share a seat with
# pnpm dev:portal. Move both to another seat's 7Sxx pair if it has to.
QCMS_PORTAL_BASE_URL=http://localhost:7000
QCMS_ADMIN_BASE_URL=http://localhost:7040
QCMS_PORTAL_PORT=7000
QCMS_ADMIN_PORT=7040

# Which host address the two published ports bind to. Loopback by default, so a
# local stack is not reachable from the network. A deployment that terminates TLS
# on a separate ingress host sets this to 0.0.0.0 (and must then have a firewall
# or private network in front of it: Docker's forwarding rules bypass host
# firewall rules that only filter the INPUT chain).
QCMS_BIND_ADDRESS=127.0.0.1

# Whether the respondent portal's session cookie carries `Secure`. Unset, the container's
# NODE_ENV=production decides, which marks it `Secure`: correct behind TLS, and fine over
# http://localhost because browsers treat loopback as a trustworthy origin. So leave it
# alone for both the local stack above and a TLS deployment. Uncomment it only if your
# browser is one that refuses to keep a `Secure` cookie on http://localhost, which is
# permitted here because the base URL above is a loopback origin.
#
# This file used to ship `QCMS_SECURE_COOKIES=false` uncommented, and copying it to .env
# then carried the downgrade into whatever you deployed next (issue #292). It no longer
# can: set it false at a NON-loopback QCMS_PORTAL_BASE_URL and the portal refuses to
# start, with an error naming this variable and the remedy. There is no supported way to
# serve respondent sessions over plain HTTP at a real hostname, because there is no way
# to do it safely.
# QCMS_SECURE_COOKIES=false

# How many proxies you run between the internet and the portal. The client address the
# API's rate limiters key on is that many entries from the RIGHT of the inbound
# X-Forwarded-For, so entries a client wrote itself are never reached.
#
# 1 is correct for both ingress recipes in docs/deploy-ingress.md (the Caddy overlay,
# which SETS the header to the peer address, and a cloud load balancer, which appends
# it) and for any operator load balancer in front of this stack, which ADR-20 says is
# where ingress belongs. Raise it only if you stack a CDN or WAF in front of that proxy,
# and read the "Stacking another proxy" section first: raising it past the number of
# proxies that actually exist makes per-address rate limiting bypassable, and no test
# can detect that from inside the process.
#
# Set it to 0 if the portal is reachable DIRECTLY with no proxy at all. Then no
# forwarded header is trusted, every respondent shares one bucket, and the rate-limit
# maxima become whole-deployment ceilings.
QCMS_PORTAL_TRUSTED_PROXY_HOPS=1

# The same count for the ADMIN hostname, used by better-auth's per-IP sign-in throttle
# (SEC-1) instead of by the respondent limiters. A separate variable because the two apps
# are two hostnames and an operator may put a CDN or WAF in front of one and not the
# other; set both, and set them to the same value unless one of them has an extra proxy
# in front of it. Everything the portal's note says about raising it past the number of
# proxies that actually exist applies here and matters more: the control it weakens is
# the one protecting sign-in, and an attacker rotating the header would get a fresh
# backoff allowance every attempt.
#
# Set it to 0 if the admin is reachable DIRECTLY with no proxy at all. Then no forwarded
# header is trusted and every sign-in attempt in the deployment shares one bucket.
QCMS_ADMIN_TRUSTED_PROXY_HOPS=1

# The admin's equivalent of QCMS_SECURE_COOKIES above. Read by BOTH the api service
# (which sets better-auth's session
# and two-factor cookies) and the admin service (which sets the enrollment, recovery-view
# and appearance cookies) - one variable, because a browser that keeps one family and
# drops the other breaks enrolment in a redirect loop rather than degrading. Unset, the
# containers' NODE_ENV=production decides, which marks them `Secure`: correct behind TLS,
# and fine over http://localhost because browsers treat loopback as a trustworthy origin.
# Setting it false at a NON-loopback QCMS_ADMIN_BASE_URL is refused: the admin refuses to
# start rather than hand an authoring session cookie to a browser over plain HTTP on a
# real network (issue #292). To evaluate over plain HTTP, reach the admin at a loopback
# origin - an SSH tunnel or a port-forward - and point QCMS_ADMIN_BASE_URL at it.
# Nothing in this repo sets it for you, deliberately: the full-stack harness keeps its
# browsed origin on http://localhost in every environment precisely so this can stay
# unset and the local run exercises the same cookie configuration as CI (issue #316).
# QCMS_ADMIN_SECURE_COOKIES=false

# Whether an admin password is checked against the public breach corpus before it is
# accepted (SEC-1; NIST SP 800-63B Rev 4 3.1.1.2 and OWASP ASVS 5.0 6.2.12 both require
# this). Default (unset) = true. When on, setting a password makes one HTTPS request to
# api.pwnedpasswords.com carrying the first five hex characters of the password's SHA-1
# and nothing else - the password never leaves the api container.
#
# The check FAILS CLOSED: with that host unreachable, the password is refused rather
# than accepted unchecked, so on an air-gapped deployment `qcms:create-admin` cannot
# create the first admin until you set this false. That is the only reason to set it,
# plus the break-glass case of rotating a leaked password while the corpus is down. It
# is a documented downgrade, and the api container logs a warning at every startup for
# as long as it is off.
# QCMS_ADMIN_PASSWORD_BREACH_CHECK=false
