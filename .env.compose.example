# Copy to .env before starting the solo Compose stack. Generate every secret
# with a cryptographically secure generator; values must be at least 32 chars.
QCMS_DB_NAME=qcms
QCMS_DB_USER=qcms
QCMS_DB_PASSWORD=replace-with-a-strong-database-password

QCMS_LINK_KEYS=replace-with-a-random-32-character-link-signing-key
QCMS_SESSION_KEYS=replace-with-a-random-32-character-session-signing-key
QCMS_INTERNAL_TOKEN=replace-with-a-random-32-character-internal-token
QCMS_APP_KEY=replace-with-a-random-32-character-app-encryption-key
# better-auth's signing secret. Read by the API, which owns the instance since task
# 056; the admin service never sees it.
#
# SET IT ONCE AND DO NOT CHANGE IT. This is not a rotatable signing key: it is the key
# the stored TOTP secret is ENCRYPTED under, so changing it does not merely end sessions,
# it makes every enrolled authenticator permanently unverifiable. Checked against
# better-auth 1.6.25's source, not inferred: `two-factor/enable` writes
# `symmetricEncrypt({ key: ctx.context.secretConfig, ... })`
# (dist/plugins/two-factor/index.mjs:105) and every verification decrypts with the
# CURRENT key (dist/plugins/two-factor/totp/index.mjs:188, and :122 for the URI reveal).
# There is no accepted-list window like QCMS_LINK_KEYS has.
#
# What survives a change is the recovery codes, and only those: they are stored as plain
# JSON because QCMS sets no `storeBackupCodes`
# (dist/plugins/two-factor/backup-codes/index.mjs:45), ten per account (:15). With no
# re-enrolment screen at launch, the recovery after a change is: sign in with a recovery
# code, then re-bootstrap the account. See docs/SECURITY_DESIGN.md section 4.
QCMS_ADMIN_AUTH_SECRET=replace-with-a-random-32-character-admin-auth-secret

# Browser-facing origins. Put the TLS ingress URLs here in a real deployment.
# The published ports are seat 0's stable portal and admin slots (docs/PORTS.md):
# this stack is long-running and human-facing, so it cannot share a seat with
# pnpm dev:portal. Move both to another seat's 7Sxx pair if it has to.
QCMS_PORTAL_BASE_URL=http://localhost:7000
QCMS_ADMIN_BASE_URL=http://localhost:7040
QCMS_PORTAL_PORT=7000
QCMS_ADMIN_PORT=7040

# Which host address the two published ports bind to. Loopback by default, so a
# local stack is not reachable from the network. A deployment that terminates TLS
# on a separate ingress host sets this to 0.0.0.0 (and must then have a firewall
# or private network in front of it: Docker's forwarding rules bypass host
# firewall rules that only filter the INPUT chain).
QCMS_BIND_ADDRESS=127.0.0.1

# Whether the respondent portal's session cookie carries `Secure`. Unset, the container's
# NODE_ENV=production decides, which marks it `Secure`: correct behind TLS, and fine over
# http://localhost because browsers treat loopback as a trustworthy origin. So leave it
# alone for both the local stack above and a TLS deployment. Uncomment it only if your
# browser is one that refuses to keep a `Secure` cookie on http://localhost, which is
# permitted here because the base URL above is a loopback origin.
#
# This file used to ship `QCMS_SECURE_COOKIES=false` uncommented, and copying it to .env
# then carried the downgrade into whatever you deployed next (issue #292). It no longer
# can: set it false at a NON-loopback QCMS_PORTAL_BASE_URL and the portal refuses to
# start, with an error naming this variable and the remedy. There is no supported way to
# serve respondent sessions over plain HTTP at a real hostname, because there is no way
# to do it safely.
# QCMS_SECURE_COOKIES=false

# How many proxies you run between the internet and the portal. The client address the
# API's rate limiters key on is that many entries from the RIGHT of the inbound
# X-Forwarded-For, so entries a client wrote itself are never reached.
#
# 1 is correct for both ingress recipes in docs/deploy-ingress.md (the Caddy overlay,
# which SETS the header to the peer address, and a cloud load balancer, which appends
# it) and for any operator load balancer in front of this stack, which ADR-20 says is
# where ingress belongs. Raise it only if you stack a CDN or WAF in front of that proxy,
# and read the "Stacking another proxy" section first: raising it past the number of
# proxies that actually exist makes per-address rate limiting bypassable, and no test
# can detect that from inside the process.
#
# Set it to 0 if the portal is reachable DIRECTLY with no proxy at all. Then no
# forwarded header is trusted, every respondent shares one bucket, and the rate-limit
# maxima become whole-deployment ceilings.
QCMS_PORTAL_TRUSTED_PROXY_HOPS=1

# The admin's equivalent. Read by BOTH the api service (which sets better-auth's session
# and two-factor cookies) and the admin service (which sets the enrollment, recovery-view
# and appearance cookies) - one variable, because a browser that keeps one family and
# drops the other breaks enrolment in a redirect loop rather than degrading. Unset, the
# containers' NODE_ENV=production decides, which marks them `Secure`: correct behind TLS,
# and fine over http://localhost because browsers treat loopback as a trustworthy origin.
# Setting it false at a NON-loopback QCMS_ADMIN_BASE_URL is refused: the admin refuses to
# start rather than hand an authoring session cookie to a browser over plain HTTP on a
# real network (issue #292). To evaluate over plain HTTP, reach the admin at a loopback
# origin - an SSH tunnel or a port-forward - and point QCMS_ADMIN_BASE_URL at it.
# Nothing in this repo sets it for you, deliberately: the full-stack harness keeps its
# browsed origin on http://localhost in every environment precisely so this can stay
# unset and the local run exercises the same cookie configuration as CI (issue #316).
# QCMS_ADMIN_SECURE_COOKIES=false
