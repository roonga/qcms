// The dev database remains on the host; Testcontainers uses sibling containers through the mounted Docker socket.
{
  "name": "qcms-dev-container",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "installOhMyZsh": true,
      "installOhMyZshConfig": true,
      "upgradePackages": false
    },
    // Match the runtime floor in .nvmrc; Corepack reads the pnpm pin from packageManager.
    "ghcr.io/devcontainers/features/node:1": { "version": "24" },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": true,
      "installDockerBuildx": true,
      "installDockerComposeSwitch": true
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },

  // Static port publishes fix this container to seat 0; rebuild after changing them.
  // The host Compose stack owns the database port, which must not be published here.
  // appPort serves CLI launchers; forwardPorts supplies editor tunnels and labels.
  "appPort": [7000, 7010, 7030, 7040],
  "forwardPorts": [7000, 7010, 7020, 7030, 7040],
  "portsAttributes": {
    "7000": { "label": "portal (next dev)", "onAutoForward": "notify" },
    "7010": { "label": "api (Hono)", "onAutoForward": "silent" },
    "7020": { "label": "dev Postgres (docker-compose.dev.yml)", "onAutoForward": "silent" },
    "7030": { "label": "artifacts (pnpm artifacts)", "onAutoForward": "silent" },
    "7040": { "label": "admin (next dev)", "onAutoForward": "notify" }
  },

  // Chromium needs host IPC to avoid shared-memory exhaustion.
  // The Docker socket grants host-daemon authority; wrappers cannot block direct manual stops.
  // The restart policy recovers crashes, not manual stops.
  "runArgs": [
    "--init",
    "--ipc=host",
    "--restart=unless-stopped",
    "--add-host=host.docker.internal:host-gateway",
    "--name=qcms-dev-container",
    "--label=com.docker.compose.project=qcms-dev"
  ],

  "containerEnv": {
    "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0",
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    // Lifecycle wrappers use this marker to refuse stopping or rebuilding their own container.
    // Hostname detection covers already-running containers that did not receive the environment setting.
    "QCMS_DEVCONTAINER": "qcms-dev-container"
    // Leave database-address detection to dev-portal so host and container checkouts share one path.
  },

  // Provision secrets through runtime files and host auth mounts so rebuilds retain credentials.
  "mounts": [
    // Create the upstream checkout directory before binding it, including on a fresh clone.
    "source=${localWorkspaceFolder}/../a2-react-aria,target=/workspaces/a2-react-aria,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.config/gh,target=/home/vscode/.config/gh,type=bind,consistency=cached"
  ],
  // This host command and localEnv:HOME require POSIX. Windows contributors must use WSL
  // or create the upstream and credential directories themselves; see docs/DEV_CONTAINER.md.
  "initializeCommand": "mkdir -p \"${localWorkspaceFolder}/../a2-react-aria\" \"$HOME/.claude\" \"$HOME/.config/gh\" || true",

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  }
}
